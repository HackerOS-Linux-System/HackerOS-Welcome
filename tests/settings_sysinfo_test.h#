use "std -> test" from "test"
use "std -> fs" from "fs"

fn main() is
    ;; settings (HOME wskazuje katalog tymczasowy)
    assert_eq(settings::preferred_source(), "sf")
    let o1: [string] = settings::source_order()
    assert_eq(o1[0], "sf")
    settings::set_preferred_source("mega")
    assert_eq(settings::preferred_source(), "mega")
    let o2: [string] = settings::source_order()
    assert_eq(o2[0], "mega")
    assert_eq(settings::source_order().len(), 5)
    settings::set_doc_lang_primary("de")
    assert_eq(settings::doc_lang_primary(), "de")
    assert_eq(settings::preferred_source(), "mega")
    assert_true(!settings::autostart_enabled())
    assert_eq(settings::load_last_tab("home"), "home")
    settings::save_last_tab("docs")
    assert_eq(settings::load_last_tab("home"), "docs")
    assert_true(settings::set_autostart(true))
    assert_true(settings::is_autostart_active())
    assert_true(settings::autostart_enabled())
    assert_true(fs::read(settings::autostart_desktop_path()).contains("X-GNOME-Autostart-enabled=true"))
    assert_true(settings::set_autostart(false))
    assert_true(!settings::is_autostart_active())
    assert_true(!settings::autostart_enabled())
    assert_eq(settings::preferred_source(), "mega")
    assert_eq(settings::autostart_content("[Desktop Entry]\nName=X"), "[Desktop Entry]\nName=X\nX-GNOME-Autostart-enabled=true\n")
    let lo: [string] = api::lang_order("de")
    assert_eq(lo[0], "de")
    assert_eq(lo.len(), 3)

    ;; sysinfo
    assert_eq(sysinfo::parse_meminfo_kb("MemTotal:       16384000 kB"), 16384000)
    let mi: [int] = sysinfo::meminfo_values("MemTotal: 100 kB\nMemFree: 5 kB\nMemAvailable: 40 kB\n")
    assert_eq(mi[0], 100)
    assert_eq(mi[1], 40)
    assert_eq(sysinfo::parse_apt("Listing... Done\nfoo/stable 1.2 amd64 [upgradable from: 1.1]\nbar/stable 2 amd64\n\n"), 2)
    assert_eq(sysinfo::parse_apt("Listing...\n"), 0)
    assert_eq(sysinfo::parse_uptime_seconds("12345.67 54321.00\n"), 12345)
    assert_eq(sysinfo::parse_uptime_seconds(""), -1)
    let st: sysinfo::SystemStatus = sysinfo::collect()
    assert_true(st.disk_fraction >= 0.0 && st.disk_fraction <= 1.0)
    write("settings+sysinfo OK ram=" + st.ram_used + "/" + st.ram_total + " disk=" + st.disk_used + "/" + st.disk_total + " up=" + st.uptime)
end
