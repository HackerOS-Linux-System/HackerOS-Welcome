;; ── Opis zrodla danych (na zywo / z cache) ──────────────────────────────────

;; Linia pod naglowkiem strony: „Pobrano na zywo z <url> • 12:34:56” albo ostrzezenie offline.
pub fn fetch_note(f: net::Fetched, path: string, extra: string) -> string is
    if f.cached is
        return "⚠ Brak połączenia z internetem — pokazano dane z pamięci podręcznej z " + util::local_time(f.at, "%d.%m.%Y %H:%M") + " (offline)"
    end
    return "● Pobrano na żywo z " + api::resolve_url(path) + "  •  " + util::local_time(f.at, "%H:%M:%S") + extra
end

;; Czy dane zasobu w cache sa starsze niz godzina (lub ich nie ma)?
;; Zastepuje cogodzinny timer z wersji Vala: timer `every` zmuszalby petle GTK do
;; ciaglego odpytywania (ok. 250 wybudzen/s), wiec odswiezamy przy wejsciu na strone.
pub fn is_stale(path: string) -> bool is
    let at: int = cache::saved_at(path)
    if at == 0 is return true end
    return time::now_unix() - at > 3600
end
