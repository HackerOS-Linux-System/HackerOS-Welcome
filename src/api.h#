mod util
mod jsparse

use "std -> strings" from "strings"

;; ── Modele ──────────────────────────────────────────────────────────────────

struct Edition is
    pub id:       string
    pub name:     string
    pub img:      string
    pub sf:       string
    pub mega:     string
    pub drive:    string
    pub transfer: string
    pub actions:  string
end

struct ReleaseEntry is
    pub version:   string
    pub desc:      string
    pub dates:     [string]
    pub changelog: [string]
end

struct DocSection is
    pub key:       string
    pub title:     string
    pub body:      string
    ;; ktory wariant jezykowy dostarczyl tresc: "pl" / "en" / "de" albo ""
    pub lang_used: string
    ;; czy tresc tej sekcji w ogole istnieje na stronie (w ktoryms jezyku)
    pub available: bool
    ;; polecenia z <code>...</code> — do przyciskow „Kopiuj”
    pub snippets:  [string]
end

struct GalleryImage is
    pub url:     string
    pub caption: string
end

pub fn base_url() -> string is
    return "https://hackeros-linux-system.github.io/HackerOS-Website/"
end

;; Pelny adres zasobu na stronie (do wyswietlenia w UI jako dowod, ze dane sa zywe).
pub fn resolve_url(path: string) -> string is
    if path.starts_with("http") is return path end
    return base_url() + path
end

pub fn edition_has_any_link(e: Edition) -> bool is
    return e.sf != "" || e.mega != "" || e.drive != "" || e.transfer != "" || e.actions != ""
end

;; Zlacza edycji w kolejnosci `order` (np. ["mega","sf",...]) — pomocnik UI.
pub fn edition_link(e: Edition, source: string) -> string is
    if source == "sf" is return e.sf end
    if source == "mega" is return e.mega end
    if source == "drive" is return e.drive end
    if source == "transfer" is return e.transfer end
    if source == "actions" is return e.actions end
    return ""
end

