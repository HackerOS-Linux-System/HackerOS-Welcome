mod util

use "bit -> gtk" from "gtk"
use "std -> process" from "proc"
use "std -> strings" from "strings"

;; ── Prymitywy ───────────────────────────────────────────────────────────────

;; Otwiera adres w domyslnej aplikacji systemu (gtk::open_uri = g_app_info_launch_default_for_uri).
pub fn open_url(url: string, ok_msg: string, err_msg: string) -> string is
    if !util::is_http_url(url) is
        return err_msg + " (niedozwolony adres)"
    end
    if gtk::open_uri(url) is return ok_msg end
    return err_msg
end

;; Najpierw Vivaldi, potem xdg-open; na koncu domyslny launcher GTK.
pub fn open_browser(url: string, ok_msg: string) -> string is
    if !util::is_http_url(url) is
        return "Błąd podczas otwierania " + url + " (niedozwolony adres)"
    end
    let browsers: [string] = ["vivaldi", "vivaldi-stable", "xdg-open"]
    let mut i: int = 0
    while i < browsers.len() is
        if proc::which(browsers[i]) != "" is
            proc::spawn(browsers[i] + " " + util::shq(url) + " >/dev/null 2>&1")
            return ok_msg
        end
        i += 1
    end
    return open_url(url, ok_msg, "Błąd podczas otwierania " + url)
end

