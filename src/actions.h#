;; Uruchamia GNOME Software (sklep z aplikacjami).
pub fn open_software() -> string is
    if proc::which("gnome-software") == "" is
        return "Błąd podczas uruchamiania Sklep z aplikacjami: nie znaleziono gnome-software"
    end
    proc::spawn("gnome-software >/dev/null 2>&1")
    return "Uruchomiono Sklep z aplikacjami."
end

;; Komenda terminala uruchamiajaca skrypt aktualizacji; "" gdy zaden terminal nie jest zainstalowany.
pub fn update_command(home: string) -> string is
    let binary: string = home + "/.hackeros/hacker/update-system"
    let inner: string = util::shq(binary) + "; echo; read -p " + util::shq("Naciśnij Enter, aby zamknąć terminal…")
    let terms: [string] = ["alacritty", "konsole", "xterm"]
    let mut i: int = 0
    while i < terms.len() is
        if proc::which(terms[i]) != "" is
            return terms[i] + " -e bash -c " + util::shq(inner) + " >/dev/null 2>&1"
        end
        i += 1
    end
    return ""
end

;; Uruchamia ~/.hackeros/hacker/update-system w terminalu (alacritty -> konsole -> xterm).
pub fn update_system() -> string is
    let cmd: string = update_command(util::home())
    if cmd == "" is return "Błąd: nie znaleziono obsługiwanego terminala." end
    proc::spawn(cmd)
    return "Uruchomiono aktualizację systemu w terminalu."
end

;; Dyspozytor akcji po nazwie — UI wiaze przyciski z nazwami (`"website"`, `"docs"`...),
;; dzieki czemu domkniecia nie musza przenosic wskaznikow na funkcje.
pub fn run(name: string) -> string is
    if name == "website" is return open_website() end
    if name == "docs" is return open_documentation() end
    if name == "tools_docs" is return open_tools_docs() end
    if name == "x" is return open_x() end
    if name == "changelog" is return open_changelog() end
    if name == "download" is return open_download() end
    if name == "github" is return open_github() end
    if name == "about_system" is return open_system_info() end
    if name == "bug" is return report_bug() end
    if name == "forum" is return open_forum() end
    if name == "software" is return open_software() end
    if name == "update" is return update_system() end
    return "Nieznana akcja: " + name
end
