use "std -> test" from "test"

fn main() is
    assert_eq(util::shq("a'b"), "'a'\\''b'")
    assert_true(util::is_http_url("https://x.y/z"))
    assert_true(!util::is_http_url("javascript:alert(1)"))
    assert_true(!util::is_http_url("https://x y"))
    assert_eq(util::find_from("abcabc", "bc", 2), 4)
    assert_eq(util::find_from("abc", "z", 0), -1)
    assert_eq(util::kv_lookup("A=1\nVariant= Pro \nB=2", "Variant="), "Pro")
    assert_eq(util::fmt1(3.14159), "3.1")
    assert_eq(util::fmt1(0.96), "1.0")
    assert_eq(util::fmt0(511.6), "512")
    assert_eq(util::format_bytes(16 * 1073741824), "16.0 GB")
    assert_eq(util::format_bytes(512 * 1048576), "512 MB")
    assert_eq(util::format_duration(90061), "1 d 1 godz.")
    assert_eq(util::format_duration(7500), "2 godz. 5 min")
    assert_eq(util::format_duration(120), "2 min")
    assert_eq(util::extract_version_number("HackerOS 1.2.3 (beta)"), "1.2.3")
    assert_eq(util::extract_version_number("v2."), "2")
    assert_eq(util::extract_version_number("none"), "")
    assert_true(util::compare_versions("1.10", "1.9") > 0)
    assert_true(util::compare_versions("1.2", "1.2.0") == 0)
    assert_true(util::compare_versions("0.9", "1.0") < 0)
    assert_eq(util::safe_name("a/b?c:d&e=f"), "a_b_c_d_e_f")
    assert_eq(util::regex_escape("/a/b.part"), "/a/b\\.part")
    assert_eq(util::regex_escape("x(1)+y"), "x\\(1\\)\\+y")
    assert_true(util::app_version() != "")
    write("util OK")
end
